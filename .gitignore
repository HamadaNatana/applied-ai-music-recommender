# Byte compiled
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
env/
venv/

# OS files
.DS_Store

# Pytest cache
.pytest_cache/

# Generated catalog cache (auto-rebuilt from HuggingFace on first run)
data/songs.parquet

# Env files (may contain Spotify creds)
.env

# Eval harness outputs (regenerated by `pytest --ollama`; only the
# directory itself is tracked via .gitkeep)
eval/results/*.csv
eval/results/*.json
